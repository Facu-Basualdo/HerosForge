{
	"schemaVersion": 1,
	"id": "estadisticasrpg",
	"version": "${version}",
	"name": "Hero's Forge",
	"description": "Subí tus estadísticas estilo RPG: pagás experiencia por puntos de vida, daño, armadura, velocidad u otra estadística. En el servidor alcanza; en el cliente suma una pantalla propia (tecla K o desde el inventario).",
	"authors": [
		"FacuBas"
	],
	"license": "MIT",
	"icon": "assets/estadisticasrpg/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.estadisticasrpg.EstadisticasRPG"
		],
		"client": [
			"com.estadisticasrpg.cliente.EstadisticasRPGCliente"
		]
	},
	"mixins": [
		"estadisticasrpg.mixins.json",
		{
			"config": "estadisticasrpg.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
