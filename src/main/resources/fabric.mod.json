{
	"schemaVersion": 1,
	"id": "herosforge",
	"version": "${version}",
	"name": "Hero's Forge",
	"description": "Level up RPG-style stats: spend experience on health, damage, armor, speed and more. Works server-side only; installed on the client it adds its own screen (K key or from the inventory).",
	"authors": [
		"FacuBas"
	],
	"contact": {
		"homepage": "https://github.com/Facu-Basualdo/EstadisticasRPG",
		"sources": "https://github.com/Facu-Basualdo/EstadisticasRPG",
		"issues": "https://github.com/Facu-Basualdo/EstadisticasRPG/issues"
	},
	"license": "MIT",
	"icon": "assets/herosforge/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.herosforge.HerosForge"
		],
		"client": [
			"com.herosforge.cliente.HerosForgeCliente"
		],
		"modmenu": [
			"com.herosforge.cliente.IntegracionConModMenu"
		]
	},
	"mixins": [
		"herosforge.mixins.json",
		{
			"config": "herosforge.client.mixins.json",
			"environment": "client"
		}
	],
	"breaks": {
		"soullink": "<3.0.0"
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
